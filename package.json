{
  "name": "mogs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "contracts": "node --import tsx scripts/check-contracts.ts",
    "provider:smoke": "node --import tsx scripts/provider-smoke.ts",
    "gate1:smoke": "node --import tsx scripts/gate1-smoke.ts",
    "generate:site": "node --import tsx scripts/generate-site.ts",
    "fixtures": "node --import tsx scripts/create-fixtures.ts",
    "eval": "node --import tsx scripts/eval.ts",
    "reset": "node --import tsx scripts/reset.ts",
    "ui:check": "node --import tsx scripts/check-ui.ts",
    "pretest": "npm run ui:check",
    "prebuild": "npm run ui:check",
    "public:seed": "npm --prefix apps/public run bootstrap:seed",
    "public:build": "npm run ui:check && node --import tsx scripts/check-ui.ts apps/public && npm --prefix apps/public run build",
    "public:start": "node --import tsx scripts/serve-public.ts",
    "public:verify": "node --import tsx scripts/check-public-deployment.ts",
    "remote:check": "node --import tsx scripts/check-remote-contracts.ts",
    "remote:migrate": "node --import tsx scripts/migrate-remote.ts",
    "remote:audit": "node --import tsx scripts/remote-audit.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "ai": "7.0.127",
    "cheerio": "1.2.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "postcss": "8.5.23"
  }
}
