{
  "name": "mogs-multichannel-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run ui:check",
    "ui:check": "node scripts/ui-check.ts",
    "fixtures": "node scripts/create-fixtures.ts",
    "evaluate": "node scripts/evaluate.ts",
    "verify:launch": "node --import tsx scripts/verify-launch-compatibility.ts",
    "evaluate:showcase": "node scripts/evaluate.ts --showcase"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "ai": "7.0.127",
    "cheerio": "1.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "postcss": "^8.5.23",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
