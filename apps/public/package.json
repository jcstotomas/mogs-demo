{
  "name": "mogs-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "bootstrap:seed": "node --import tsx ../../scripts/public-bootstrap.ts --mode=seed && node --import tsx scripts/deployment-meta.ts",
    "bootstrap:commit": "node --import tsx ../../scripts/public-bootstrap.ts --mode=commit && node --import tsx scripts/deployment-meta.ts",
    "predev": "npm run bootstrap:seed",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "prebuild": "node --import tsx ../../scripts/public-bootstrap.ts && node --import tsx scripts/deployment-meta.ts",
    "build": "next build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
