# Copy to ignored .env.local; keep real credentials out of Git.
# Jev uses the single direct HTTP integration.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Frontier structured fixes and fallback judge use Anthropic directly.
ANTHROPIC_API_KEY=
FRONTIER_MODEL=claude-sonnet-5-5
FIX_MODEL=claude-sonnet-5-5
# Step 0 gate selected frontier; Jev failed grandfathering and savings.
JUDGE_ADAPTER=frontier
T_REL=0.2
T_LABEL=0.7
JUDGE_CONCURRENCY=4
PROVIDER_TIMEOUT_MS=20000
MOGS_DATABASE_PATH=data/app.db
MOGS_CONTENT_ROOT=content
MOGS_FACTS_PATH=data/facts.json
MOGS_BASE_URL=http://localhost:3000

# v2 coordinator stays local and never uses the v1 database or publisher.
MOGS_REMOTE_DATABASE_PATH=data/remote/app.db
MOGS_FULL_RUN_DEADLINE_MS=180000
MOGS_GITHUB_REPOSITORY=jcstotomas/mogs-demo
MOGS_GITHUB_BASE_REF=main
# Isolated Git checkout for baseline readback; never point at repaired v1 content.
MOGS_REMOTE_SOURCE_ROOT=data/remote/source
# Local GitHub App auth. Download the private PEM outside this repository.
# Contents/Pull requests/Commit statuses write; Administration read at runtime.
# Administration write is needed when the coordinator configures branch protection.
MOGS_GITHUB_APP_CLIENT_ID=
MOGS_GITHUB_INSTALLATION_ID=
MOGS_GITHUB_PRIVATE_KEY_PATH=
# Optional manual installation token fallback when no private-key path is configured.
MOGS_GITHUB_TOKEN=
MOGS_STATUS_PRODUCER_APP_ID=
MOGS_STATUS_PRODUCER_APP_SLUG=
MOGS_PRODUCTION_ORIGIN=
# Public build sitemap origin; production project sets the verified alias.
MOGS_PUBLIC_ORIGIN=
MOGS_VERCEL_PROJECT_ID=
MOGS_VERCEL_TEAM_ID=
# Optional local read-only observation token; otherwise use the existing Vercel CLI login.
# Never copy CLI credentials into evidence or the public build.
MOGS_VERCEL_TOKEN=

# Local campaign review. Exact 1 enables it; missing/0 keeps UI and APIs off.
# npm run demo opts in and starts the integrated app on port 3110.
MOGS_MULTICHANNEL_ENABLED=0
MOGS_DEMO_PORT=3110
MOGS_LAB_PORT=3220
MOGS_LAB_STORAGE=main-campaign-demo
# Optional separate model credential; otherwise the local demo uses ANTHROPIC_API_KEY.
MOGS_LAB_ANTHROPIC_API_KEY=
MOGS_LAB_MODEL=claude-sonnet-5-5
